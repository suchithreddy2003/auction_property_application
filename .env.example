# ----------------------------------------------------------------------------
# PostgreSQL (Neon) — used for local dev and production.
# Use the direct (unpooled) connection string from the Neon dashboard and keep
# ?sslmode=require. (If you switch to Neon's pooled endpoint, add a directUrl to
# the datasource in prisma/schema.prisma so migrations use the unpooled URL.)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ----------------------------------------------------------------------------
# Auth — generate with: openssl rand -base64 32
# ----------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-random-32-byte-string"

# ----------------------------------------------------------------------------
# Email (Resend). Leave empty in dev — emails will be logged to console.
# Verify your sending domain (SPF + DKIM) before going live.
# ----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="alerts@example.com"

# ----------------------------------------------------------------------------
# Object storage (Cloudflare R2 — S3-compatible).
# Leave empty in dev — uploads will go to .uploads/ on disk.
# ----------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="auction-docs"
# Optional: custom domain or worker URL for direct public access.
R2_PUBLIC_BASE_URL=""

# ----------------------------------------------------------------------------
# Payments (Razorpay). Leave empty for demo mode (instant activation, no
# real payment). Add Test Mode keys first, then Live Mode for production.
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ----------------------------------------------------------------------------
# Cron / ingest secret — Vercel cron auto-sends this as Bearer auth.
# Generate with: openssl rand -base64 32
# ----------------------------------------------------------------------------
CRON_SECRET="change-me"

# ----------------------------------------------------------------------------
# Public site URL — used in emails, sitemap, redirect targets.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Optional: error monitoring (Sentry).
# ----------------------------------------------------------------------------
SENTRY_DSN=""
